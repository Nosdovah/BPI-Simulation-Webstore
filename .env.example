# ------------------------------------------------------------------
# OSR Sandbox — variabel lingkungan
# Semua opsional. Tanpa file .env, webstore tetap jalan penuh
# (katalog deterministik + order bertanda tangan di URL).
# ------------------------------------------------------------------

# baseline | tobe — default kalau cookie belum diset
OSR_MODE=tobe

# Kunci HMAC untuk token order. Ganti di deployment publik.
OSR_ORDER_SECRET=osr-sandbox-dev-secret-2026

# Kalau diisi, storefront memakai core eksternal (docker-compose OSR penuh)
# OSR_CORE_URL=http://localhost:8000

# Persistence order opsional (belum dipakai di versi ini)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=