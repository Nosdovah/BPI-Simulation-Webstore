# ------------------------------------------------------------------
# Webstore Octarine — variabel lingkungan
# Salin ke .env.local lalu isi.
# ------------------------------------------------------------------

# Kunci HMAC untuk token order. Ganti di deployment publik.
OSR_ORDER_SECRET=***

# --- Autentikasi & RBAC ---------------------------------------------
# Kunci HMAC cookie sesi (login). Kalau kosong, jatuh ke OSR_ORDER_SECRET.
# Generate: openssl rand -hex 32
OSR_SESSION_SECRET=***

# Kode undangan pendaftaran admin di /register. Tanpa kode ini, siapa pun
# bisa menaikkan dirinya jadi admin lewat request manual. Ganti sebelum
# dipakai untuk data nyata.
OSR_ADMIN_INVITE_CODE=***

# --- Penyimpanan user -----------------------------------------------
# Urutan backend otomatis: KV → .data/users.json → /tmp → memori.
# Serverless (Vercel) hanya bisa menulis ke /tmp, dan isinya hilang saat
# cold start. Sambungkan Upstash Redis (Vercel KV) untuk penyimpanan
# permanen — env yang dibaca: KV_REST_API_URL + KV_REST_API_TOKEN
# atau UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN.
# KV_REST_API_URL=***
# KV_REST_API_TOKEN=***

# --- Sumber master data: ERP (BPI-Simulation-ERP) -------------------
# KONTRAK RESMI = replika Perpack (bukan blueprint-v2).
# Endpoint yang dipakai: /api/webhooks/catalog, /api/webhooks/purchase-order,
# /api/webhooks/wms, /v1/*, /api/to-be/*.
# /api/v2/* SUDAH DITINGGALKAN.
#
# snapshot (default): baca .data/erp/catalog.snapshot.json hasil `npm run erp:sync`
# live             : tarik langsung dari ERP saat proses start
OSR_CATALOG_SOURCE=snapshot

# ERP OSR (replika Perpack). Lokal: port 8100. Produksi: Railway.
OSR_ERP_BASE_URL=https://web-production-e60b55.up.railway.app

# Auth OPSIONAL — replika Perpack terbuka. Kalau diisi, dikirim apa adanya
# sebagai header `Authorization` (tanpa prefix "Bearer", meniru Perpack asli).
# OSR_ERP_TOKEN=

# Timeout & retry HTTP ke ERP
OSR_ERP_TIMEOUT_MS=30000
OSR_ERP_RETRIES=2

# 1 = ikut menarik stok per gudang (/v1/products/group/page, ±5 MB)
# 0 = cukup katalog flat (lebih cepat, tanpa rincian gudang)
OSR_ERP_WAREHOUSE_STOCK=1

# 1 = gagal keras kalau live pull error dan snapshot tidak ada (produksi)
# 0 = fallback ke snapshot terakhir (demo)
OSR_ERP_STRICT=0

# Lokasi snapshot (opsional, default ./.data/erp/catalog.snapshot.json)
# OSR_ERP_SNAPSHOT_PATH=/var/lib/osr/catalog.snapshot.json

# --- Jalur B: order (Webstore → Modul 4.2 ERP) ---------------------
# push = setiap checkout dikirim ke POST /api/webhooks/purchase-order
# off  = storefront berdiri sendiri (tidak ada order di ERP)
OSR_ERP_ORDER_MODE=push

# 1 = checkout gagal kalau ERP menolak order (produksi)
OSR_ERP_ORDER_STRICT=0

# 1 = status order ditarik ulang dari ERP (POST /v1/orders/page) saat dibaca
OSR_ERP_ORDER_SYNC=1

# Cache pembacaan status (ms)
OSR_ERP_STATUS_TTL_MS=3000

# Channel WEBSTORE di ERP (lihat GET /v1/channels)
OSR_ERP_CHANNEL_ID=13

# webhook = penjualan dikirim ke ERP lewat `stock.updated` (ERP sumber kebenaran)
# local   = overlay "terjual" hanya di storefront
OSR_ERP_STOCK_OVERLAY=webhook

# --- Tampilan stok bundling ----------------------------------------
# as-is (default) = angka `stock_available` ERP apa adanya (termasuk phantom)
# to-be           = hitung BOM MIN(⌊stok komponen / multiplier⌋)
OSR_STOCK_MODE=as-is

# --- Webhook receiver ERP → storefront (POST /api/webhooks/wms) -----
# Wajib minimal 16 karakter. Generate: openssl rand -hex 24
OSR_WEBHOOK_TOKEN=ganti-...x-24

# Opsional. Kalau diisi, setiap request wajib punya header
#   X-OSR-Signature: sha256=<hmac_sha256(raw_body, secret)>
# OSR_WEBHOOK_HMAC_SECRET=***

# --- Supabase: akun pengguna + keranjang server-side ------------------
# URL project (Settings → API → Project URL)
SUPABASE_URL=https://<project-ref>.supabase.co

# WAJIB service_role (bukan anon). Tabel osr_user & osr_cart memakai RLS
# tanpa policy, jadi anon key ditolak total. Kunci ini hanya boleh ada di
# server — jangan pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=***

# Kalau dua variabel di atas kosong, aplikasi jatuh ke penyimpanan berkas
# (.data/users.json). Di Vercel itu berarti /tmp: user yang mendaftar akan
# hilang saat instance berganti. Jangan jalankan production tanpa Supabase.
