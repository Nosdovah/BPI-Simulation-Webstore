# ------------------------------------------------------------------
# OSR Sandbox — variabel lingkungan
# Salin ke .env.local lalu isi.
# ------------------------------------------------------------------

# baseline | tobe — default kalau cookie belum diset
OSR_MODE=tobe

# Kunci HMAC untuk token order. Ganti di deployment publik.
OSR_ORDER_SECRET=ganti-di-produksi

# --- Sumber master data: ERP (BPI-Simulation-ERP) -------------------
# Webstore TIDAK menyimpan katalog hardcoded. Semua produk, harga, stok,
# dan BOM berasal dari ERP OSR (repo Nosdovah/BPI-Simulation-ERP).
#
# snapshot (default): baca .data/erp/catalog.snapshot.json hasil `npm run erp:sync`
# live             : tarik langsung dari ERP saat proses start
OSR_CATALOG_SOURCE=snapshot

# ERP OSR (FastAPI + SQLite). Lokal: port 8100. Produksi: URL PaaS ERP.
OSR_ERP_BASE_URL=http://127.0.0.1:8100

# Opsional. Kalau ERP dijalankan dengan OSR_ERP_SERVICE_TOKEN, isi nilai yang sama.
OSR_ERP_TOKEN=

# Timeout & retry HTTP ke ERP
OSR_ERP_TIMEOUT_MS=20000
OSR_ERP_RETRIES=2

# 1 = gagal keras kalau live pull error dan snapshot tidak ada (produksi)
# 0 = fallback ke snapshot terakhir (demo)
OSR_ERP_STRICT=0

# Lokasi snapshot (opsional, default ./.data/erp/catalog.snapshot.json)
# OSR_ERP_SNAPSHOT_PATH=/var/lib/osr/catalog.snapshot.json

# Kalau diisi, storefront memakai core eksternal (docker-compose OSR penuh)
# OSR_CORE_URL=http://localhost:8000

# --- Webhook receiver ERP → core (POST /api/webhooks/wms) ----------
# Wajib minimal 16 karakter. Generate: openssl rand -hex 24
OSR_WEBHOOK_TOKEN=ganti-dengan-openssl-rand-hex-24

# Opsional. Kalau diisi, setiap request wajib punya header
#   X-OSR-Signature: sha256=<hmac_sha256(raw_body, secret)>
# OSR_WEBHOOK_HMAC_SECRET=

# Persistence order opsional
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=